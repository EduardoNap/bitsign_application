# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/bob_dashboard

# AWS credentials / region
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# S3 bucket where contract PDFs are uploaded
S3_BUCKET=
S3_RAW_PREFIX=raw/

# Bedrock Agent used by the chat
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=

# Public backend URL (set to your load balancer / domain in production)
API_URL=http://localhost:8000
